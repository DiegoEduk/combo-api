# ==============================================================================
# CONFIGURACIÓN DEL ENTORNO (FastAPI + PostgreSQL + Redis + MinIO)
# ==============================================================================

# Entorno de ejecución: development, staging, production
ENVIRONMENT=production
DEBUG=false

# Configuración del servidor FastAPI
PROJECT_NAME="ComboAPI - FastAPI Modular"
API_V1_STR=/api/v1
HOST=0.0.0.0
PORT=8000
HOST_PORT=8080  # Puerto expuesto en el host (en Coolify usar 8080 o superior para no chocar con el puerto 8000 de Coolify)

# PostgreSQL (Dentro de la red Docker privada se usa el hostname 'postgres')
# Formato: postgresql+psycopg://USUARIO:CONTRASEÑA@HOST:PUERTO/NOMBRE_BD
POSTGRES_USER=combo_user
POSTGRES_PASSWORD=combo_super_password
POSTGRES_DB=combo_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://combo_user:combo_super_password@postgres:5432/combo_db

# Redis (Dentro de la red Docker privada se usa el hostname 'redis')
# Formato: redis://[:CONTRASEÑA@]HOST:PUERTO/DB
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_TTL=60

# MinIO (Servicio S3 compatible, en Docker se usa el hostname 'minio')
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_super_secret_password
MINIO_ACCESS_KEY=minio_admin
MINIO_SECRET_KEY=minio_super_secret_password
MINIO_BUCKET=img
MINIO_BUCKET_ARCHIVOS=archivos
MINIO_SECURE=false
